{
  "name": "apology-protocol",
  "version": "0.1.0",
  "description": "Validates typed, signed plan artifacts for agent sagas — a bad plan fails validation, not production.",
  "type": "module",
  "license": "MIT",
  "author": "Valerio Uberti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valeriouberti/apology-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/valeriouberti/apology-protocol/issues"
  },
  "homepage": "https://www.valeriouberti.dev/articles/agents-can-talk-but-they-cannot-commit",
  "keywords": [
    "agents",
    "saga",
    "compensation",
    "validation",
    "zod",
    "mcp",
    "a2a",
    "ap2"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/plan.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "examples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "schema": "npm run build && node scripts/generate-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run schema"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
